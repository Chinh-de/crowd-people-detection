# Chép thành demo/backend/.env rồi đổi giá trị. File .env không đưa lên git.

# Tài khoản quản trị (mọi quyền). Mặc định admin/admin; đổi mật khẩu khi triển khai thật.
CROWD_ADMIN_USER=admin
CROWD_ADMIN_PASSWORD=admin

# Tài khoản chỉ xem (không bắt buộc): xem và xác nhận cảnh báo, không sửa cấu hình.
CROWD_VIEWER_USER=vanhanh
CROWD_VIEWER_PASSWORD=doi-mat-khau-nay

# Khóa ký phiên đăng nhập. Thiếu thì sinh ngẫu nhiên mỗi lần chạy (khởi động lại phải đăng nhập lại).
CROWD_SECRET=mot-chuoi-ngau-nhien-dai

# Số camera chạy cùng lúc tối đa (giới hạn phần cứng CPU), số ngày giữ số liệu thô và clip cảnh báo.
CROWD_MAX_CAMERAS=4
CROWD_RAW_DAYS=3
CROWD_CLIP_DAYS=30
